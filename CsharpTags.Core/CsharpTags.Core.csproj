<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Title>CsharpTags.Core</Title>
    <Authors>Frairlyn Camilo Roque Suarez</Authors>
    <Copyright>Copyright (c) Frairlyn Camilo Roque Suarez. All rights reserved.</Copyright>
    <PackageTags>C#, HTML</PackageTags>
    <Summary>Easy and type safe html.</Summary>
    <Description>Provides a way to construct html in a type-safe way.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.1.0-beta4</Version>
    <PackageProjectUrl>https://github.com/cheerio-pixel/CsharpTags</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="LanguageExt.Core" Version="5.0.0-beta-57" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="LanguageExt.Core" Version="5.0.0-beta-36" />
  </ItemGroup>

    <ItemGroup>
       <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
